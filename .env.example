# Application connects as the restricted role (RLS enforced, audit table insert-only).
DATABASE_URL=postgres://taxops_app:taxops_app@localhost:5433/taxops
# Migrations and seeding connect as the owner role.
DATABASE_OWNER_URL=postgres://taxops_owner:taxops_owner@localhost:5433/taxops

# DEVELOPMENT ONLY. Dev auth lists fictional users and signs them in without a password.
# The app refuses to start with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEV_TENANT_SLUG=northwind

# LLM gateway (used by the Python agent worker from Phase 3 onward)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
