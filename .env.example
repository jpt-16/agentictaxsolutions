# Application connects as the restricted role (RLS enforced, audit table insert-only).
DATABASE_URL=postgres://taxops_app:taxops_app@localhost:5433/taxops
# The Python agent worker connects as a role with no table access (jobs_* functions only).
WORKER_DATABASE_URL=postgres://taxops_worker:taxops_worker@localhost:5433/taxops
# Migrations and seeding connect as the owner role.
DATABASE_OWNER_URL=postgres://taxops_owner:taxops_owner@localhost:5433/taxops

# DEVELOPMENT ONLY. Dev auth lists fictional users and signs them in without a password.
# The app refuses to start with AUTH_MODE=dev when NODE_ENV=production.
AUTH_MODE=dev
AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEV_TENANT_SLUG=northwind

# LLM gateway (used by the Python agent worker from Phase 3 onward)
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# File uploads. Dev: local disk + an EICAR-only stub scanner. Production REQUIRES a real scanner and object storage.
STORAGE_DIR=.storage
# CLAMAV_HOST=clamav        # clamd host; the app refuses to start uploads in production without it
# CLAMAV_PORT=3310

# AI agents. Tenants opt in separately for (1) AI extraction at all and (2) sending content to an external model:
#   pnpm tenant:flags <slug> --ai on --external-llm on
# Without GEMINI_API_KEY (or with external LLM off) the extraction agent still works using deterministic header matching.
# GEMINI_MODEL=gemini-2.5-flash   # confirm the current model id before use
